{
  "name": "@ostro/view",
  "version": "1.0.1",
  "description": "View module for OstroJS",
  "scripts": {
    "build": "rm -rf build && npx tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "main": "build/viewManager.js",
  "types": "build/viewManager.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/viewManager.d.ts",
      "default": "./build/viewManager.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "dependencies": {
    "@ostro/support": "^1.0.2",
    "bluebird": "^3.7.2",
    "lodash.get": "^4.4.2"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "nodejs view",
    "view"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/view.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/view/issues"
  },
  "homepage": "https://github.com/ostrojs/view#readme",
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
